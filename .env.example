# =========================================================================
# CODE OBSIDIAN - Environment Variables Template
# Copy this file to '.env' and fill in your keys. Do NOT commit the '.env' file.
# =========================================================================

# -------------------------------------------------------------------------
# 1. API Endpoint Configuration
# -------------------------------------------------------------------------
# In local development, the backend runs on http://localhost:3001.
# In production, point this to your Render/backend service URL (e.g. https://your-backend.onrender.com).
VITE_API_URL=http://localhost:3001

# -------------------------------------------------------------------------
# 2. AI Model API Keys (Supports Failover & Key Rotation)
# -------------------------------------------------------------------------

# Primary: Groq API Key (Llama 3.3 70B)
# Get a key at: https://console.groq.com/keys
# You can provide multiple keys separated by commas for automatic round-robin rotation.
VITE_GROQ_KEY=gsk_your_primary_groq_key_here

# Failover 1: Google Gemini API Key (Gemini 1.5 Flash)
# Get a key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_KEY=your_gemini_key_here

# Failover 2: OpenRouter API Key (DeepSeek R1)
# Get a key at: https://openrouter.ai/keys
VITE_OPENROUTER_KEY=your_openrouter_key_here

# -------------------------------------------------------------------------
# 3. Secure Code Execution Sandbox
# -------------------------------------------------------------------------
# Judge0 API Key (obtained from RapidAPI) for running user code sandboxes.
VITE_JUDGE0_KEY=your_judge0_rapidapi_key_here
